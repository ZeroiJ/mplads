# Hugging Face credentials for the RS similarity space
HF_TOKEN=hf_your_token_here
HF_SPACE_RS=https://your-space-name.hf.space

# Absolute path to the cloned mplads repo on this host.
# Defaults to ../mplads relative to this file (works for local dev).
# MPLADS_REPO=/home/zeroij/mplads

# Optional: token required by clients calling POST /api/similar.
# Leave unset to skip the gate during local smoke tests.
# API_TOKEN=change-me
