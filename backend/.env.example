# Hugging Face credentials for the LS embedding Space (ZeroiJ's fine-tuned model).
# The backend calls the Gradio /predict endpoint on this Space to live-embed work
# descriptions for duplicate detection (D2) and the /api/similar endpoint.
HF_TOKEN=hf_your_token_here
HF_SPACE_LS=https://zeroij-mplads-ls-embed.hf.space

# Absolute path to the cloned mplads repo on this host.
# Defaults to ../mplads relative to this file (works for local dev).
# MPLADS_REPO=/home/zeroij/mplads

# Optional: token required by clients calling POST /api/similar.
# Leave unset to skip the gate during local smoke tests.
# API_TOKEN=change-me